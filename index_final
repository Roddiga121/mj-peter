<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">
<meta name="referrer" content="strict-origin-when-cross-origin">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MJ & Peter — 1 Anno Speciale</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;700;900&family=Caveat:wght@600;700&family=Special+Elite&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<script src="https://open.spotify.com/embed/iframe-api/v1" async></script>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin=""/>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<style>
  :root{
    --navy:#1A2B4C;
    --ink:#101d33;
    --duskblue:#3a5a80;
    --mist:#9db3cd;
    --paper:#FDFBF7;
    --paper-shadow:#e7e0cf;
    --gold:#c9a35d;
    --cream:#f7f3ea;
    --tape: rgba(253,251,247,0.55);

    /* ---- scala spaziature ---- */
    --sp-3xs:4px; --sp-2xs:8px; --sp-xs:12px; --sp-sm:16px;
    --sp-md:24px; --sp-lg:32px; --sp-xl:48px; --sp-2xl:64px;

    /* ---- scala raggi ---- */
    --r-sm:8px; --r-md:14px; --r-lg:20px; --r-pill:999px;

    /* ---- scala ombre ---- */
    --sh-sm:0 4px 10px rgba(0,0,0,.22);
    --sh-md:0 14px 28px rgba(0,0,0,.35);
    --sh-lg:0 26px 52px rgba(0,0,0,.48);

    /* ---- durate / easing ---- */
    --ease-soft:cubic-bezier(.22,.61,.36,1);
    --ease-spring:cubic-bezier(.34,1.45,.64,1);
    --dur-fast:160ms;
    --dur-base:340ms;
    --dur-slow:560ms;
  }

  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent;}
  html{ scroll-behavior:smooth; }
  html,body{margin:0;padding:0;}
  a:focus-visible, button:focus-visible, input:focus-visible, [tabindex]:focus-visible{
    outline:2px solid var(--gold); outline-offset:2px; border-radius:4px;
  }
  /* ---- reveal all'ingresso in viewport: fade + leggero translateY/scale ---- */
  .reveal{
    opacity:0;
    transform:translateY(16px) scale(.985);
    transition:opacity var(--dur-slow) var(--ease-soft), transform var(--dur-slow) var(--ease-soft);
    will-change:opacity, transform;
  }
  .reveal.in-view{ opacity:1; transform:translateY(0) scale(1); }
  .reveal-1{ transition-delay:.06s; }
  .reveal-2{ transition-delay:.12s; }
  .reveal-3{ transition-delay:.18s; }
  body{
    background:var(--navy);
    color:var(--cream);
    font-family:'Inter',sans-serif;
    overflow-x:hidden;
  }
  body::before{
    content:"";
    position:fixed; inset:0; z-index:1;
    pointer-events:none;
    background:radial-gradient(ellipse at 50% 0%, rgba(255,255,255,0.05), transparent 55%),
               radial-gradient(ellipse at 50% 100%, rgba(0,0,0,0.35), transparent 60%);
  }
  ::-webkit-scrollbar{width:10px;}
  ::-webkit-scrollbar-thumb{background:var(--duskblue); border-radius:10px;}
  ::-webkit-scrollbar-track{background:var(--ink);}

  /* ============ GRAIN / FLICKER ============ */
  .grain{
    pointer-events:none;
    position:fixed; inset:0; z-index:999;
    opacity:0;
    background:repeating-radial-gradient(circle at 20% 30%, rgba(255,255,255,0.05) 0, transparent 2px);
    mix-blend-mode:overlay;
    transition:opacity .12s ease;
  }
  .grain.flash{opacity:1;}

  /* ============ LOCK SCREEN ============ */
  #lock{
    position:fixed; inset:0; z-index:1000;
    background:
      radial-gradient(circle at 50% 20%, rgba(255,255,255,0.05), transparent 60%),
      linear-gradient(160deg, var(--ink), var(--navy) 70%);
    display:flex; align-items:center; justify-content:center;
    flex-direction:column;
    padding:24px;
    text-align:center;
    transition:opacity var(--dur-slow) var(--ease-soft), visibility var(--dur-slow) var(--ease-soft), filter var(--dur-slow) var(--ease-soft);
  }
  #lock.unlocked{ opacity:0; visibility:hidden; pointer-events:none; filter:blur(6px); }
  .lock-card{
    background:var(--paper);
    color:var(--ink);
    border-radius:var(--r-md);
    padding:44px 32px;
    max-width:340px;
    width:100%;
    box-shadow:var(--sh-lg), inset 0 0 0 1px rgba(0,0,0,.05);
    position:relative;
    opacity:0;
    transform:translateY(18px) scale(.96);
    transition:opacity var(--dur-slow) var(--ease-soft), transform var(--dur-slow) var(--ease-soft);
  }
  .lock-card.in{ opacity:1; transform:translateY(0) scale(1); }
  .lock-card.shake{ animation:lockShake .45s var(--ease-soft); }
  @keyframes lockShake{
    10%,90%{ transform:translateX(-1px); }
    20%,80%{ transform:translateX(3px); }
    30%,50%,70%{ transform:translateX(-7px); }
    40%,60%{ transform:translateX(7px); }
  }
  .lock-card::before{
    content:"";
    position:absolute; top:-14px; left:50%; transform:translateX(-50%) rotate(-3deg);
    width:70px; height:26px; background:var(--tape);
    border:1px solid rgba(0,0,0,.05);
  }
  .lock-icon{ font-size:30px; margin-bottom:6px; display:inline-block; transition:transform var(--dur-base) var(--ease-spring); }
  .lock-icon.success{ transform:scale(1.3) rotate(-10deg); }
  .lock-card h2{
    font-family:'Playfair Display',serif;
    font-weight:900;
    font-size:22px;
    margin:6px 0 2px;
    color:var(--navy);
  }
  .lock-card p.sub{
    font-family:'Caveat',cursive;
    font-size:18px;
    color:var(--duskblue);
    margin:0 0 20px;
  }
  .pin-wrap{ position:relative; width:100%; }
  .pin-dots{
    display:flex; align-items:center; justify-content:center; gap:14px;
    min-height:52px;
    border:1.5px solid var(--duskblue);
    border-radius:var(--r-sm);
    background:#fff;
    transition:border-color var(--dur-fast) ease;
  }
  .pin-wrap:focus-within .pin-dots{ border-color:var(--gold); }
  .pin-dot{
    width:13px; height:13px; border-radius:50%;
    border:1.5px solid var(--duskblue);
    background:transparent;
    transform:scale(.55);
    opacity:.55;
    transition:transform var(--dur-fast) var(--ease-spring), opacity var(--dur-fast) ease, background var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .pin-dot.filled{ background:var(--navy); border-color:var(--navy); transform:scale(1); opacity:1; }
  #lock-input{
    position:absolute; inset:0; width:100%; height:100%;
    opacity:0;
    border:none; background:transparent;
    padding:0; margin:0;
    text-align:center; font-size:20px;
    color:var(--navy);
    cursor:text;
  }
  #lock-btn{
    margin-top:14px;
    width:100%;
    padding:13px;
    border:none;
    border-radius:var(--r-sm);
    background:var(--navy);
    color:var(--cream);
    font-family:'Inter',sans-serif;
    font-weight:600;
    font-size:14px;
    letter-spacing:.05em;
    cursor:pointer;
    transition:background var(--dur-base) ease, transform var(--dur-fast) var(--ease-spring);
  }
  #lock-btn:hover{ background:var(--ink); }
  #lock-btn:active{ transform:scale(.97); }
  #lock-error{
    font-size:13px;
    color:#a5433a;
    margin-top:10px;
    min-height:16px;
    font-family:'Inter',sans-serif;
  }

  /* ============ HOME / FRAME ============ */
  #home{
    position:relative;
    width:100%;
    min-height:100vh;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:24px;
    transition:opacity var(--dur-base) ease, filter var(--dur-base) ease;
  }
  #home.hidden{opacity:0; pointer-events:none; position:absolute; filter:blur(6px);}

  .frame-wrap{
    position:relative;
    max-width:1100px;
    width:100%;
    border-radius:6px;
    overflow:hidden;
    box-shadow:var(--sh-lg);
    perspective:1200px;
    opacity:0;
    transform:translateY(26px) scale(.97);
    transition:opacity var(--dur-slow) var(--ease-soft), transform var(--dur-slow) var(--ease-soft);
  }
  .frame-wrap.in{ opacity:1; transform:translateY(0) scale(1); }
  .frame-tilt{
    position:relative;
    width:100%;
    transform-style:preserve-3d;
    will-change:transform;
    transition:transform .6s var(--ease-soft);
  }
  .frame-tilt img{
    display:block;
    width:100%;
    height:auto;
  }

  .hotspot{
    position:absolute;
    border-radius:14px;
    cursor:pointer;
    background:transparent;
    transform:translateY(0) scale(1);
    box-shadow:0 0 0 rgba(0,0,0,0);
    transition:transform .28s cubic-bezier(.2,.9,.3,1.3), box-shadow .28s ease, background .28s ease;
  }
  .hotspot:hover, .hotspot:focus-visible, .hotspot.tapped{
    transform:translateY(-6px) scale(1.02);
    background:rgba(201,163,93,0.10);
    box-shadow:
      0 14px 26px rgba(0,0,0,.35),
      0 4px 10px rgba(0,0,0,.25),
      inset 0 0 0 1.5px rgba(201,163,93,0.55);
    outline:none;
  }
  .hotspot span{
    position:absolute;
    bottom:-32px;
    left:50%;
    transform:translateX(-50%);
    font-family:'Caveat',cursive;
    font-weight:700;
    font-size:20px;
    color:var(--gold);
    white-space:nowrap;
    opacity:0;
    transition:opacity .25s ease;
    pointer-events:none;
  }
  .hotspot:hover span, .hotspot:focus-visible span, .hotspot.tapped span{opacity:1;}

  /* mappa collegamenti: foto centrali->collage | ciak->universi AI | vinile+cassetta->musica | calendario->countdown */
  #hs-fotocentrali{ left:34%; top:37%; width:35.5%; height:33%; }
  #hs-ciak{ left:20%; top:6%; width:22%; height:30%; }
  #hs-vinile{ left:79%; top:19%; width:19%; height:35%; }
  #hs-cassetta{ left:7%; top:47%; width:30%; height:33%; }
  #hs-calendario{ left:82%; top:60%; width:16%; height:33%; }

  .home-caption{
    text-align:center;
    margin-top:22px;
    font-family:'Caveat',cursive;
    font-size:22px;
    color:var(--mist);
    opacity:0;
    transform:translateY(10px);
    transition:opacity var(--dur-slow) var(--ease-soft) .18s, transform var(--dur-slow) var(--ease-soft) .18s;
  }
  .home-caption.in{ opacity:1; transform:translateY(0); }

  /* ============ SUBPAGES SHELL ============ */
  .page{
    position:fixed;
    inset:0;
    background:linear-gradient(180deg, var(--navy), var(--ink) 60%, var(--navy));
    z-index:50;
    display:flex;
    flex-direction:column;
    align-items:center;
    padding:64px 18px 90px;
    overflow-y:auto;
    transform:translateY(26px) scale(.985);
    opacity:0;
    pointer-events:none;
    transition:opacity var(--dur-slow) var(--ease-soft), transform var(--dur-slow) var(--ease-soft);
    will-change:opacity, transform;
  }
  .page.active{ opacity:1; transform:translateY(0) scale(1); pointer-events:all; }

  .back-btn{
    position:fixed;
    top:22px;
    left:22px;
    z-index:60;
    background:rgba(20,40,63,0.75);
    border:1px solid var(--gold);
    color:var(--cream);
    font-family:'Inter',sans-serif;
    font-size:13px;
    letter-spacing:.04em;
    padding:9px 16px;
    border-radius:var(--r-pill);
    cursor:pointer;
    backdrop-filter:blur(6px);
    transition:background var(--dur-base) ease, transform var(--dur-fast) var(--ease-spring), border-color var(--dur-base) ease;
  }
  .back-btn:hover{background:rgba(201,163,93,0.18); border-color:var(--gold);}
  .back-btn:active{ transform:scale(.97); }

  .page h1{
    font-family:'Playfair Display',serif;
    font-weight:900;
    font-size:clamp(28px, 5vw, 52px);
    color:var(--cream);
    margin:8px 0 4px;
    text-align:center;
  }
  .page .kicker{
    font-family:'Caveat',cursive;
    font-weight:700;
    font-size:23px;
    color:var(--gold);
    margin-bottom:24px;
    text-align:center;
  }
  .page .kicker::before, .page .kicker::after{
    content:"✷";
    font-family:'Inter',sans-serif;
    font-size:13px;
    color:var(--gold);
    opacity:.55;
    vertical-align:middle;
    margin:0 8px;
  }

  /* ============ B. MUSICA ============ */
  .music-wrap{ max-width:420px; width:100%; display:flex; flex-direction:column; align-items:center; }

  .player-card{
    background:var(--paper);
    color:var(--ink);
    border-radius:18px;
    padding:26px 22px;
    box-shadow:0 20px 40px rgba(0,0,0,.4);
    display:flex; flex-direction:column; align-items:center; gap:10px;
    width:100%;
  }
  .player-card h3{ font-family:'Playfair Display',serif; margin:0; font-size:19px; color:var(--navy); text-align:center; }
  .player-card .ded{ font-family:'Caveat',cursive; font-size:17px; color:var(--duskblue); margin-top:-6px; text-align:center; }

  /* manopola selettore */
  .mode-switch-wrap{ display:flex; flex-direction:column; align-items:center; gap:8px; margin-bottom:6px; }
  .mode-knob{
    width:52px; height:52px; border-radius:50%;
    background:radial-gradient(circle at 35% 30%, #3a5a80, #14283f 72%);
    box-shadow:0 6px 14px rgba(0,0,0,.4), inset 0 0 0 2px rgba(201,163,93,0.55);
    position:relative; cursor:pointer; flex:none;
    transition:transform .45s cubic-bezier(.3,.8,.3,1.2);
  }
  .mode-knob[data-mode="vinyl"]{ transform:rotate(180deg); }
  .mode-knob:active{ transform:scale(.94); }
  .mode-knob[data-mode="vinyl"]:active{ transform:rotate(180deg) scale(.94); }
  .mode-knob-dot{
    position:absolute; top:6px; left:50%; transform:translateX(-50%);
    width:6px; height:6px; border-radius:50%; background:var(--gold);
    box-shadow:0 0 6px rgba(201,163,93,.8);
  }
  .mode-labels{ display:flex; gap:16px; font-family:'Inter',sans-serif; font-size:11px; letter-spacing:.04em; color:var(--duskblue); }
  .mode-labels .mode-label-item.active{ color:var(--navy); font-weight:700; }

  @keyframes spin{ to{ transform:rotate(360deg); } }

  /* mangianastri */
  .cassette-deck{ display:flex; justify-content:center; margin:4px 0 2px; }
  .deck-shell{
    width:230px; height:140px;
    background:
      linear-gradient(160deg, rgba(255,255,255,0.14), rgba(255,255,255,0.01)),
      linear-gradient(160deg, #2b2b2b, #161616);
    border-radius:10px;
    border:1px solid rgba(255,255,255,0.14);
    display:flex; align-items:center; justify-content:space-between;
    padding:0 24px;
    position:relative;
    box-shadow:inset 0 0 0 1px rgba(255,255,255,.06), 0 10px 18px rgba(0,0,0,.4);
  }
  .deck-shell::after{
    content:"!ly · thasup";
    position:absolute; top:12px; left:50%; transform:translateX(-50%);
    font-family:'Special Elite',monospace; color:#e9c98b; font-size:10.5px; letter-spacing:.05em;
  }
  .reel-window{
    width:50px; height:50px; border-radius:50%;
    background:radial-gradient(circle, #0a0a0a 0 6px, #242424 7px 20px, #0a0a0a 21px 25px);
    display:flex; align-items:center; justify-content:center;
  }
  .reel-cog{
    width:32px; height:32px; border-radius:50%;
    background:repeating-conic-gradient(#101010 0deg 15deg, #3d3d3d 15deg 30deg);
    animation:spin 2.4s linear infinite; animation-play-state:paused;
  }
  .cassette-deck.playing .reel-cog{ animation-play-state:running; }
  .tape-line{ position:absolute; left:50%; top:50%; transform:translate(-50%,-50%); width:112px; height:2px; background:rgba(140,105,60,0.7); }

  /* giradischi */
  .turntable{ display:flex; justify-content:center; margin:4px 0 2px; }
  .tt-base{
    width:230px; height:160px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.06), transparent 40%),
      repeating-linear-gradient(100deg, #3d2b1f 0 5px, #4a3423 5px 10px);
    border-radius:12px;
    box-shadow:0 12px 22px rgba(0,0,0,.45), inset 0 0 0 2px rgba(201,163,93,0.3);
    position:relative;
  }
  .tt-platter{
    position:absolute; left:18px; top:18px;
    width:122px; height:122px; border-radius:50%;
    background:radial-gradient(circle, #1a1a1a 0 5px, #262626 6px, #141414 7px 120px);
    box-shadow:0 6px 14px rgba(0,0,0,.4);
  }
  .tt-disc{
    position:absolute; inset:0; border-radius:50%;
    background:
      repeating-radial-gradient(circle, #0c0c0c 0 3px, #1c1c1c 3px 5px),
      radial-gradient(circle, var(--gold) 0 13px, #111 14px);
    animation:spin 1.7s linear infinite; animation-play-state:paused;
  }
  .turntable.playing .tt-disc{ animation-play-state:running; }
  .tt-arm{
    position:absolute; right:24px; top:12px;
    width:6px; height:82px;
    background:linear-gradient(180deg, var(--gold), #8a6a34);
    border-radius:4px;
    transform-origin:top center;
    transform:rotate(-34deg);
    transition:transform .6s cubic-bezier(.3,.8,.3,1.1);
    box-shadow:0 4px 10px rgba(0,0,0,.4);
  }
  .turntable.playing .tt-arm{ transform:rotate(-7deg); }
  .tt-arm-head{ position:absolute; bottom:-4px; left:50%; transform:translateX(-50%); width:14px; height:10px; background:#222; border-radius:2px; }

  /* equalizzatore condiviso */
  .eq-bars{ display:flex; align-items:flex-end; gap:4px; height:28px; margin:10px 0 2px; }
  .eq-bars span{
    width:5px; border-radius:2px;
    background:linear-gradient(180deg, var(--gold), var(--cream));
    height:20%;
    animation:eqPulse 1s ease-in-out infinite;
    animation-play-state:paused;
  }
  .eq-bars.playing span{ animation-play-state:running; }
  .eq-bars span:nth-child(1){ animation-delay:0s; }
  .eq-bars span:nth-child(2){ animation-delay:.12s; }
  .eq-bars span:nth-child(3){ animation-delay:.24s; }
  .eq-bars span:nth-child(4){ animation-delay:.06s; }
  .eq-bars span:nth-child(5){ animation-delay:.3s; }
  .eq-bars span:nth-child(6){ animation-delay:.18s; }
  .eq-bars span:nth-child(7){ animation-delay:.36s; }
  @keyframes eqPulse{ 0%,100%{ height:20%; } 50%{ height:100%; } }

  .play-toggle{
    border:1px solid var(--navy);
    background:var(--navy);
    color:var(--cream);
    font-family:'Inter',sans-serif;
    font-size:13px;
    font-weight:600;
    padding:11px 22px;
    min-height:44px;
    border-radius:var(--r-pill);
    cursor:pointer;
    letter-spacing:.03em;
    transition:background var(--dur-base) ease, transform var(--dur-fast) var(--ease-spring), box-shadow var(--dur-base) ease;
    box-shadow:var(--sh-sm);
  }
  .play-toggle:hover{ background:var(--ink); box-shadow:var(--sh-md); }
  .play-toggle:active{ transform:scale(.97); }

  .spotify-embed{ width:100%; border-radius:12px; overflow:hidden; }
  .spotify-embed iframe{ display:block; width:100%; border:0; }

  /* ============ C. COUNTDOWN ============ */
  .together-hero{
    position:relative;
    background:var(--paper);
    color:var(--ink);
    border-radius:var(--r-lg);
    padding:28px 26px;
    text-align:center;
    max-width:520px;
    width:100%;
    margin-bottom:26px;
    box-shadow:var(--sh-lg);
  }
  .together-hero::before{
    content:"";
    position:absolute; top:-11px; left:50%; transform:translateX(-50%) rotate(2deg);
    width:58px; height:20px; background:var(--tape);
    border:1px solid rgba(0,0,0,.05);
  }
  .together-since{ font-family:'Caveat',cursive; font-weight:700; font-size:19px; color:var(--duskblue); margin-bottom:6px; }
  .together-main{ font-family:'Playfair Display',serif; font-weight:900; font-size:clamp(22px,4.4vw,30px); color:var(--navy); line-height:1.25; }
  .together-sub{ font-family:'Inter',sans-serif; font-size:12.5px; letter-spacing:.03em; color:var(--duskblue); margin-top:10px; }

  .countdown-wrap{ display:flex; flex-wrap:wrap; gap:22px; justify-content:center; max-width:780px; }
  .countdown-card{
    flex:1 1 300px;
    background:var(--paper);
    color:var(--ink);
    border-radius:var(--r-lg);
    padding:26px 24px;
    text-align:center;
    box-shadow:var(--sh-md);
  }
  .countdown-card h3{ font-family:'Playfair Display',serif; font-size:19px; color:var(--navy); margin:0 0 2px; }
  .countdown-card .cd-date{ font-family:'Caveat',cursive; font-size:19px; color:var(--duskblue); margin-bottom:16px; }
  .cd-grid{ display:flex; justify-content:center; gap:14px; margin-bottom:18px; }
  .cd-unit{ min-width:52px; }
  .cd-num{
    font-family:'Playfair Display',serif; font-weight:900; font-size:32px; color:var(--navy);
    font-variant-numeric:tabular-nums; display:inline-block; min-width:1.5ch;
    animation:cdTick var(--dur-fast) var(--ease-soft);
  }
  @keyframes cdTick{ from{ opacity:.35; transform:translateY(-3px); } to{ opacity:1; transform:translateY(0); } }
  .cd-label{ font-family:'Inter',sans-serif; font-size:10px; letter-spacing:.08em; text-transform:uppercase; color:var(--duskblue); margin-top:2px; }
  .progress-track{ position:relative; height:8px; background:var(--paper-shadow); border-radius:6px; margin-top:6px; }
  .progress-fill{ position:absolute; inset:0 auto 0 0; background:linear-gradient(90deg, var(--duskblue), var(--gold)); border-radius:6px; transition:width 1s linear; }
  .progress-heart{ position:absolute; top:50%; transform:translate(-50%,-50%); font-size:16px; transition:left 1s linear; }

  /* ============ D. UNIVERSI AI — LIBRO 3D ============ */
  .book-title{
    font-family:'Caveat',cursive;
    font-weight:700;
    font-size:34px;
    color:var(--gold);
    margin-bottom:26px;
    text-align:center;
  }
  .book-stage{
    perspective:1800px;
    width:min(320px, 84vw);
    aspect-ratio:3/4;
    position:relative;
  }
  .book{
    position:relative;
    width:100%; height:100%;
    border-radius:8px;
    background:linear-gradient(155deg, var(--navy), var(--ink));
    box-shadow:0 24px 50px rgba(0,0,0,.5), inset 0 0 0 6px rgba(0,0,0,.25);
  }
  .book-page{
    position:absolute; inset:0;
    border-radius:8px;
    overflow:hidden;
    background:var(--paper);
    transform-origin:left center;
    transform-style:preserve-3d;
    transition:transform .8s cubic-bezier(.4,.1,.2,1);
    backface-visibility:hidden;
  }
  .book-page img{
    position:absolute; inset:0;
    width:100%; height:100%;
    object-fit:cover;
  }
  .book-page.flipped{ transform:rotateY(-165deg); box-shadow:-12px 0 30px rgba(0,0,0,.35); }
  .page-label{
    position:absolute; left:0; right:0; bottom:0;
    padding:10px 8px;
    text-align:center;
    background:rgba(16,29,51,0.82);
    color:var(--cream);
    font-family:'Special Elite',monospace;
    font-size:11.5px;
    letter-spacing:.03em;
  }
  .book-nav{ display:flex; gap:20px; margin-top:24px; }
  .book-arrow{
    width:42px; height:42px; border-radius:50%;
    background:var(--paper); color:var(--navy);
    border:none; font-size:18px; cursor:pointer;
    box-shadow:var(--sh-sm);
    display:flex; align-items:center; justify-content:center;
    transition:transform var(--dur-fast) var(--ease-spring), box-shadow var(--dur-base) ease;
  }
  .book-arrow:hover{ box-shadow:var(--sh-md); }
  .book-arrow:active{ transform:scale(.97); }
  .book-count{ font-family:'Inter',sans-serif; font-size:12px; color:var(--mist); margin-top:12px; letter-spacing:.05em; }


  /* ============ ENGAGED COUNTER (reuses together-hero) ============ */
  .together-hero + .together-hero{ margin-top:-10px; }

  /* ============ AGENDA CALENDARIO ============ */
  .cal-card{
    background:var(--paper); color:var(--ink);
    border-radius:var(--r-lg); padding:22px; max-width:420px; width:100%;
    box-shadow:var(--sh-md);
  }
  .cal-header{ display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; }
  .cal-month-label{ font-family:'Playfair Display',serif; font-weight:700; font-size:18px; color:var(--navy); transition:opacity var(--dur-fast) ease, transform var(--dur-fast) ease; }
  .cal-month-label.switching{ opacity:0; transform:translateY(4px); }
  .cal-arrow{
    width:40px; height:40px; border-radius:50%; border:none; background:var(--navy); color:var(--cream);
    font-size:16px; cursor:pointer; flex:none;
    transition:transform var(--dur-fast) var(--ease-spring), background var(--dur-base) ease;
  }
  .cal-arrow:hover{ background:var(--ink); }
  .cal-arrow:active{ transform:scale(.97); }
  .cal-weekdays{ display:grid; grid-template-columns:repeat(7,1fr); font-family:'Inter',sans-serif; font-size:10px; letter-spacing:.06em; text-transform:uppercase; color:var(--duskblue); text-align:center; margin-bottom:8px; }
  .cal-grid{ display:grid; grid-template-columns:repeat(7,1fr); gap:5px; transition:opacity var(--dur-fast) ease, transform var(--dur-fast) ease; }
  .cal-grid.switching{ opacity:0; transform:translateX(var(--cal-slide, 10px)); }
  .cal-day{
    aspect-ratio:1; display:flex; align-items:center; justify-content:center;
    border-radius:var(--r-sm); font-family:'Inter',sans-serif; font-size:12.5px; color:var(--ink);
    background:transparent; position:relative;
    transition:transform var(--dur-fast) var(--ease-spring), background var(--dur-fast) ease;
  }
  .cal-day.empty{ visibility:hidden; }
  .cal-day.has-event{ background:rgba(58,90,128,0.12); cursor:pointer; font-weight:600; }
  .cal-day.has-event:hover{ background:rgba(58,90,128,0.24); }
  .cal-day.has-event:active{ transform:scale(.9); }
  .cal-day.highlight{ background:rgba(201,163,93,0.28); box-shadow:0 0 0 2px var(--gold) inset; font-weight:700; }
  .cal-day .dot{ position:absolute; bottom:3px; width:4px; height:4px; border-radius:50%; background:var(--duskblue); }
  .cal-day.highlight .dot{ background:var(--gold); width:5px; height:5px; }

  /* ============ VIEW SWITCH (Calendario / Mappa) ============ */
  #agendaCalendarView, #agendaMapView{
    width:100%;
    display:flex;
    flex-direction:column;
    align-items:center;
  }
  .view-switch{
    position:relative;
    display:flex; gap:0; background:rgba(253,251,247,0.1);
    border:1px solid rgba(201,163,93,0.4); border-radius:var(--r-pill);
    padding:5px; max-width:420px; width:100%; margin:0 0 18px;
  }
  .view-switch-indicator{
    position:absolute; top:5px; left:5px;
    width:calc(50% - 5px); height:calc(100% - 10px);
    background:var(--paper); border-radius:var(--r-pill);
    box-shadow:var(--sh-sm);
    transition:transform var(--dur-base) var(--ease-spring);
    transform:translateX(0%);
    z-index:0;
    pointer-events:none;
  }
  .view-switch-indicator.pos-map{ transform:translateX(100%); }
  .view-switch-btn{
    position:relative; z-index:1;
    flex:1; border:none; background:transparent; color:var(--mist);
    font-family:'Inter',sans-serif; font-weight:600; font-size:12.5px;
    padding:10px 8px; border-radius:var(--r-pill); cursor:pointer;
    transition:color var(--dur-base) ease, transform var(--dur-fast) var(--ease-spring);
  }
  .view-switch-btn.active{ color:var(--navy); }
  .view-switch-btn:active{ transform:scale(.97); }
  .map-hint{
    text-align:center; font-family:'Caveat',cursive; font-size:19px;
    color:var(--mist); margin:0 0 14px;
  }

  /* ============ AGENDA — VISTA MAPPA ============ */
  .agenda-map{
    width:100%; max-width:520px; height:440px; margin:0 auto;
    border-radius:var(--r-lg); overflow:hidden;
    box-shadow:var(--sh-md), inset 0 0 0 4px var(--paper);
    background:var(--paper);
  }
  /* filtro "carta chiara minimal": stessi tile OpenStreetMap (nessuna chiave
     richiesta), ma molto più chiari, desaturati e a basso contrasto — la
     mappa resta uno sfondo discreto e i marker restano i protagonisti */
  .agenda-map .leaflet-tile-pane{
    filter:saturate(0.35) brightness(1.2) contrast(0.9) grayscale(0.15);
  }
  .agenda-map .leaflet-control-attribution{ font-size:9px; }

  .scrap-pin{
    position:relative; width:40px; height:40px;
    background:var(--paper);
    border:2px solid var(--gold);
    border-radius:50% 50% 50% 0;
    box-shadow:0 6px 12px rgba(0,0,0,.4);
    display:flex; align-items:center; justify-content:center;
    cursor:pointer;
    animation:pinDrop var(--dur-slow) var(--ease-spring) both;
  }
  @keyframes pinDrop{
    from{ opacity:0; transform:rotate(-45deg) translateY(-16px) scale(.6); }
    to{ opacity:1; transform:rotate(-45deg) translateY(0) scale(1); }
  }
  .scrap-pin:hover{ transform:rotate(-45deg) scale(1.08); box-shadow:0 10px 18px rgba(0,0,0,.5); }
  .scrap-pin.bounce{ animation:pinBounce .5s var(--ease-spring); }
  @keyframes pinBounce{
    0%{ transform:rotate(-45deg) scale(1); }
    35%{ transform:rotate(-45deg) scale(1.22) translateY(-6px); }
    65%{ transform:rotate(-45deg) scale(.94); }
    100%{ transform:rotate(-45deg) scale(1); }
  }
  .scrap-pin .scrap-emoji{ transform:rotate(45deg); font-size:17px; line-height:1; }
  .scrap-pin .scrap-badge{
    position:absolute; top:-9px; right:-9px;
    transform:rotate(45deg);
    background:var(--navy); color:var(--cream);
    border:1.5px solid var(--gold);
    border-radius:50%;
    min-width:19px; height:19px; padding:0 3px;
    display:flex; align-items:center; justify-content:center;
    font-family:'Inter',sans-serif; font-weight:700; font-size:10.5px;
  }

  .map-popup{ font-family:'Inter',sans-serif; color:var(--ink); max-width:230px; }
  .map-popup h4{ font-family:'Playfair Display',serif; color:var(--navy); font-size:16px; margin:0 0 2px; }
  .map-popup .map-popup-address{ font-family:'Caveat',cursive; font-size:15px; color:var(--duskblue); margin:0 0 10px; }
  .map-popup .map-popup-list{ max-height:190px; overflow-y:auto; padding-right:2px; }
  .map-popup .map-popup-item{ padding:6px 0; border-top:1px dashed #d8d0bd; }
  .map-popup .map-popup-item:first-child{ border-top:none; }
  .map-popup .map-popup-item-date{ font-family:'Caveat',cursive; font-weight:700; color:var(--duskblue); font-size:13.5px; display:block; }
  .map-popup .map-popup-item-title{ font-weight:600; font-size:12.5px; display:block; margin:1px 0; }
  .map-popup .map-popup-item-desc{ font-size:11.5px; line-height:1.4; color:#444; margin:0; }
  .map-popup .map-popup-empty{ font-size:12px; color:#777; font-style:italic; }
  .leaflet-popup-content-wrapper{ background:var(--paper); border-radius:var(--r-md); box-shadow:var(--sh-md); }
  .leaflet-popup-tip{ background:var(--paper); }

  .modal-place{ font-family:'Caveat',cursive; font-weight:700; font-size:16px; color:var(--gold); margin:0 0 4px; }

  /* ============ MODALS ============ */
  .modal-overlay{
    position:fixed; inset:0; z-index:80;
    background:rgba(10,18,32,0.72);
    display:flex; align-items:center; justify-content:center;
    padding:20px;
    opacity:0; visibility:hidden;
    transition:opacity var(--dur-base) var(--ease-soft), visibility var(--dur-base) var(--ease-soft);
  }
  .modal-overlay.active{ opacity:1; visibility:visible; }
  .modal-card{
    background:var(--paper); color:var(--ink);
    border-radius:var(--r-lg); padding:28px 24px 24px; max-width:420px; width:100%;
    max-height:80vh; overflow-y:auto;
    box-shadow:var(--sh-lg);
    position:relative;
    transform:translateY(14px) scale(.94); opacity:0;
    transition:transform var(--dur-base) var(--ease-spring), opacity var(--dur-fast) ease;
  }
  .modal-overlay.active .modal-card{ transform:translateY(0) scale(1); opacity:1; }
  .modal-card.is-highlight{ box-shadow:var(--sh-lg), 0 0 0 3px var(--gold); }
  .modal-close{
    position:absolute; top:12px; right:14px; border:none; background:none;
    font-size:17px; cursor:pointer; color:var(--duskblue);
    width:32px; height:32px; border-radius:50%;
    display:flex; align-items:center; justify-content:center;
    transition:background var(--dur-fast) ease, transform var(--dur-fast) var(--ease-spring);
  }
  .modal-close:hover{ background:rgba(58,90,128,0.1); }
  .modal-close:active{ transform:scale(.9); }
  .modal-date{ font-family:'Caveat',cursive; font-weight:700; font-size:19px; color:var(--duskblue); margin-bottom:4px; }
  .modal-card h3{ font-family:'Playfair Display',serif; color:var(--navy); margin:0 0 10px; font-size:19px; }
  .modal-card p{ font-family:'Inter',sans-serif; font-size:14px; line-height:1.65; color:#333; margin:0; }

  .form-label{ display:block; font-family:'Inter',sans-serif; font-size:12px; color:var(--duskblue); margin:12px 0 4px; }
  .form-input{ width:100%; padding:10px 11px; border:1px solid #cfc7b3; border-radius:var(--r-sm); font-family:'Inter',sans-serif; font-size:13px; background:#fff; color:var(--ink); transition:border-color var(--dur-fast) ease; }
  .form-input:focus{ border-color:var(--gold); outline:none; }
  .form-check{ display:flex; align-items:center; gap:8px; margin:14px 0 6px; font-family:'Inter',sans-serif; font-size:13px; color:var(--ink); }
  .place-chips{ display:flex; flex-wrap:wrap; gap:8px; margin:2px 0 4px; }
  .place-chip{
    border:1.5px solid #cfc7b3; background:#fff; color:var(--ink);
    font-family:'Inter',sans-serif; font-size:12.5px; font-weight:600;
    padding:8px 14px; border-radius:var(--r-pill); cursor:pointer;
    transition:border-color var(--dur-fast) ease, background var(--dur-fast) ease, transform var(--dur-fast) var(--ease-spring), color var(--dur-fast) ease;
  }
  .place-chip:active{ transform:scale(.96); }
  .place-chip.selected{ border-color:var(--gold); background:rgba(201,163,93,0.16); color:var(--navy); }
  .modal-actions{ display:flex; gap:10px; margin-top:18px; }
  .modal-actions .play-toggle{ flex:1; }
  .play-toggle.danger{ background:#a5433a; border-color:#a5433a; }
  .play-toggle.danger:hover{ background:#8a372f; }

  .confetti-piece{ position:absolute; font-size:15px; pointer-events:none; animation:confettiFall 1.1s ease-out forwards; }
  @keyframes confettiFall{
    from{ opacity:1; transform:translateY(0) rotate(0deg); }
    to{ opacity:0; transform:translateY(70px) rotate(220deg); }
  }

  /* ============ CUORE DI FOTO DINAMICO ============ */
  .heart-toolbar{ text-align:center; margin-bottom:20px; }
  .upload-btn{
    display:inline-block;
    background:var(--paper); color:var(--navy);
    font-family:'Inter',sans-serif; font-weight:600; font-size:13px;
    padding:11px 22px; min-height:44px; line-height:22px; border-radius:var(--r-pill); cursor:pointer;
    box-shadow:var(--sh-sm);
    transition:box-shadow var(--dur-base) ease, transform var(--dur-fast) var(--ease-spring);
  }
  .upload-btn:hover{ box-shadow:var(--sh-md); }
  .upload-btn:active{ transform:scale(.97); }
  .heart-field{
    position:relative;
    width:100%;
    max-width:520px;
    aspect-ratio:1/1.04;
    margin:0 auto;
    touch-action:none;
    cursor:zoom-in;
    overflow:hidden;
    border-radius:10px;
  }
  .heart-field.is-zoomed{ cursor:grab; }
  .heart-field.is-panning{ cursor:grabbing; }
  .heart-photo{
    position:absolute;
    left:0; top:0;
    background:var(--paper);
    padding:4px 4px 9px;
    border-radius:2px;
    box-shadow:0 6px 14px rgba(0,0,0,.35);
    will-change:transform, width;
    animation:heartPop .5s ease both;
    animation-delay:var(--delay,0s);
    cursor:pointer;
  }
  @media (min-width:700px){ .heart-field{ max-width:640px; } }
  .heart-photo.is-focused{ box-shadow:0 16px 28px rgba(0,0,0,.45); }
  .heart-photo img{ display:block; width:100%; aspect-ratio:1/1; object-fit:cover; border-radius:1px; pointer-events:none; }
  .heart-photo .tape{ position:absolute; top:-6px; left:50%; transform:translateX(-50%) rotate(-3deg); width:24px; height:9px; background:var(--tape); pointer-events:none; }
  @keyframes heartPop{
    from{ opacity:0; }
    to{ opacity:1; }
  }
  .heart-note{ max-width:420px; text-align:center; font-size:12px; color:var(--mist); margin:22px auto 0; line-height:1.6; }


  /* ============ DIARIO SEGRETO 3D ============ */
  .diary-card{
    width:100%;
    max-width:280px;
    aspect-ratio:3/4;
    margin:8px auto 0;
    border-radius:14px;
    cursor:pointer;
    position:relative;
    background:
      repeating-linear-gradient(90deg, rgba(0,0,0,0.08) 0 2px, transparent 2px 7px),
      linear-gradient(155deg, #223a5e, #0d1a2e 55%, #16283f);
    box-shadow:
      0 30px 60px rgba(0,0,0,.55),
      inset 0 0 0 2px rgba(201,163,93,0.4),
      inset 0 0 40px rgba(0,0,0,.45);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    padding:26px;
    transform:perspective(900px) rotateX(0deg) rotateY(0deg);
    transition:transform .4s cubic-bezier(.2,.8,.3,1.2), box-shadow .4s ease;
  }
  .diary-card:hover, .diary-card:focus-visible{
    transform:perspective(900px) rotateX(4deg) rotateY(-7deg) translateY(-6px);
    box-shadow:0 40px 80px rgba(0,0,0,.6), inset 0 0 0 2px rgba(201,163,93,0.6), inset 0 0 40px rgba(0,0,0,.45);
    outline:none;
  }
  .diary-card::before{
    content:"";
    position:absolute; left:16px; top:16px; right:16px; bottom:16px;
    border:1.5px solid rgba(201,163,93,0.45);
    border-radius:8px;
    pointer-events:none;
  }
  .diary-clasp{
    width:34px; height:46px;
    background:linear-gradient(160deg, var(--gold), #8a6a34);
    border-radius:6px 6px 10px 10px;
    box-shadow:0 6px 14px rgba(0,0,0,.5), inset 0 0 0 1px rgba(255,255,255,.25);
    margin-bottom:18px;
    position:relative;
    flex:none;
  }
  .diary-clasp::after{ content:"❤"; position:absolute; inset:0; display:flex; align-items:center; justify-content:center; color:#1a2b4c; font-size:14px; }
  .diary-title{
    font-family:'Playfair Display',serif;
    font-weight:900;
    font-size:21px;
    color:var(--gold);
    text-align:center;
    letter-spacing:.02em;
    line-height:1.35;
    text-shadow:0 2px 6px rgba(0,0,0,.4);
  }
  .diary-sub{
    font-family:'Caveat',cursive;
    font-weight:700;
    font-size:16px;
    color:var(--mist);
    margin-top:12px;
  }

  /* ============ CONTATORE COMPATTO ============ */
  .cd-grid.compact{ gap:16px; }
  .cd-grid.compact .cd-num{ font-size:22px; }
  .cd-grid.compact .cd-label{ font-size:9px; }

  /* ============ LIGHTBOX FOTO ============ */
  .lightbox-card{ max-width:520px; padding:16px 16px 20px; text-align:center; }
  .lightbox-card img{ width:100%; display:block; border-radius:6px; box-shadow:0 14px 28px rgba(0,0,0,.35); }
  .lightbox-caption{ font-family:'Caveat',cursive; font-weight:700; font-size:19px; color:var(--duskblue); margin-top:14px; }

  /* ============ RIFINITURE RESPONSIVE (320–430px) ============ */
  @media (max-width:360px){
    .cd-grid{ gap:8px; }
    .cd-unit{ min-width:44px; }
    .cd-num{ font-size:26px; }
    .countdown-card{ padding:22px 16px; }
    .together-hero{ padding:24px 18px; }
    .cal-card{ padding:18px; }
    .modal-card{ padding:24px 18px 20px; }
  }

  @media (prefers-reduced-motion: reduce){
    *{animation:none !important; transition:none !important;}
  }
</style>
</head>
