  const PROPOSAL_DATE = new Date(2026, 3, 28, 0, 0, 0); // 28 aprile 2026
  function renderEngagedUnits(){
    const now = new Date();
    let y = now.getFullYear() - PROPOSAL_DATE.getFullYear();
    let m = now.getMonth() - PROPOSAL_DATE.getMonth();
    let d = now.getDate() - PROPOSAL_DATE.getDate();
    if(d < 0){
      m--;
      const prevMonth = new Date(now.getFullYear(), now.getMonth(), 0);
      d += prevMonth.getDate();
    }
    if(m < 0){ y--; m += 12; }
    const totalMonths = y*12 + m;
    document.getElementById('engaged-grid').innerHTML = [
      [totalMonths, totalMonths===1?'mese':'mesi'], [d, d===1?'giorno':'giorni']
    ].map(([n,l])=>`<div class="cd-unit"><div class="cd-num">${n}</div><div class="cd-label">${l}</div></div>`).join('');
  }
  renderEngagedUnits();
  setInterval(renderEngagedUnits, 60000);

