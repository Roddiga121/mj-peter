  function closeLightbox(){ document.getElementById('photoLightbox').classList.remove('active'); }

  /* ---------- motore di zoom: UNA SOLA superficie fissa, mai un nuovo layout ----------
     Ogni foto ha una posizione propria "base" (baseX, baseY) dentro la forma del
     cuore, calcolata UNA SOLA VOLTA quando la foto viene creata. Questa posizione
     non cambia mai durante l'interazione: non esiste una "posizione B" diversa
     verso cui animarsi, quindi le foto non possono riordinarsi o scambiarsi
     di posto. Zoomare significa semplicemente guardare questa stessa superficie
     fissa con un "moltiplicatore" (zoom) e una "telecamera" (originX/originY)
     diversi — esattamente come lo zoom su una mappa o su un'immagine:

       schermoX = centro + (baseX - originX) * zoom
       schermoY = centro + (baseY - originY) * zoom

     Il punto del mondo sotto il dito/cursore resta sotto il dito/cursore perché,
     ad ogni variazione di zoom, si ricalcola originX/originY in modo da
     compensare esattamente il cambio di scala in quel punto (vedi applyZoomAt).
     La dimensione delle foto cresce con lo zoom ma più lentamente della
     distanza tra loro (SIZE_GROWTH < 1): è per questo che, aprendo lo zoom, le
     foto si separano invece di restare semplicemente più grandi e sovrapposte
     nello stesso modo. Nessun valore qui dipende dalle foto vicine: niente
     collision avoidance, niente ricalcolo del layout, niente rimescolamento. */
  let photoMeta = [];
  let layout = null;

  const ZOOM_MIN = 1;
  const ZOOM_MAX = 6.5;
  const SIZE_GROWTH = 0.6; // <1: le foto crescono più lentamente di quanto si allontanino tra loro

  let zoom = ZOOM_MIN, targetZoom = ZOOM_MIN, zoomVel = 0;
  let originX = 0, originY = 0, targetOriginX = 0, targetOriginY = 0;
  let zoomRafId = null;
  let isPointerDown = false, dragMoved = false, wasDragging = false;
  let lastPointer = null;
  let lastPinchDist = null;

  function renderHeart(){
    const field = document.getElementById('heartField');
    field.innerHTML = '';
    photoMeta = [];
    zoom = ZOOM_MIN; targetZoom = ZOOM_MIN; zoomVel = 0;
    originX = 0; originY = 0; targetOriginX = 0; targetOriginY = 0;
    const order = shuffleArr(HEART_PHOTOS.slice());
    const n = order.length;
    const pts = sampleHeartPoints(n);
    order.forEach((url, i)=>{
      const p = pts[i] || pts[i % Math.max(pts.length,1)] || {x:0,y:0};
      const div = document.createElement('div');
      div.className = 'heart-photo';
      div.style.setProperty('--delay', (Math.random()*0.6) + 's');
      div.innerHTML = `<div class="tape"></div><img loading="lazy" src="${url}" alt="ricordo MJ &amp; Peter">`;
      div.addEventListener('click', ()=>{ if(!wasDragging) openLightbox(url); });
      field.appendChild(div);
      photoMeta.push({
        el: div,
        // coordinate del cuore nello spazio parametrico (fisse per sempre, assegnate una sola volta)
        hx: p.x, hy: p.y,
        rot: (Math.random()*6 - 3).toFixed(1),
        // posizione base in pixel: calcolata da computeLayout, ma SEMPRE la stessa combinazione hx/hy
        baseX: 0, baseY: 0
      });
    });
    computeLayout();
    kickZoomLoop();
  }

  // Ricalcola solo la scala pixel del cuore compatto (es. al resize): riusa le
  // stesse hx/hy fissate alla creazione, quindi è un semplice ridimensionamento
  // uniforme, non una nuova disposizione.
  function computeLayout(){
    const field = document.getElementById('heartField');
    const rect = field.getBoundingClientRect();
    const fw = rect.width || 320, fh = rect.height || fw*1.04;
    const aSize = fw < 480 ? 58 : 76;
    const HEART_RADIUS = fw * 0.38;
    layout = { fw, fh, aSize, HEART_RADIUS, contentHalf: HEART_RADIUS*1.3 + aSize*0.6 };
    photoMeta.forEach(p=>{
      p.baseX = p.hx * HEART_RADIUS;
      p.baseY = -p.hy * HEART_RADIUS; // y del cuore cresce verso l'alto, lo schermo verso il basso
    });
  }
  window.addEventListener('resize', ()=>{
    if(!layout) return;
    computeLayout();
    const clamped = clampOrigin(targetOriginX, targetOriginY, targetZoom);
    targetOriginX = clamped.x; targetOriginY = clamped.y;
    kickZoomLoop();
  });

  document.getElementById('photoUpload').addEventListener('change', async e=>{
    const files = Array.from(e.target.files);
    const customPhotos = loadCustomHeartPhotos();
    for(const f of files){
      try{
        const dataUrl = await resizeImageFile(f);
        customPhotos.push(dataUrl);
        HEART_PHOTOS.push(dataUrl);
      }catch(err){ console.error('errore nel caricare una foto', err); }
    }
    saveCustomHeartPhotos(customPhotos);
    renderHeart();
    e.target.value = '';
  });
  renderHeart();

  /* ---------- telecamera: solo zoom + pan, mai una posizione ricalcolata ---------- */
  function clampOrigin(ox, oy, z){
    if(!layout) return {x:0, y:0};
    const field = document.getElementById('heartField');
    const rect = field.getBoundingClientRect();
    const halfW = (rect.width/2)/z;
    const halfH = (rect.height/2)/z;
    const maxX = Math.max(0, layout.contentHalf - halfW);
    const maxY = Math.max(0, layout.contentHalf - halfH);
    return { x: Math.min(maxX, Math.max(-maxX, ox)), y: Math.min(maxY, Math.max(-maxY, oy)) };
  }

  // Cambia lo zoom mantenendo fisso, sotto il dito/cursore, lo stesso punto del
  // "mondo" — esattamente come lo zoom di una mappa: non è mai lo schermo intero
  // a ricentrarsi da solo.
  function applyZoomAt(newZoom, clientX, clientY){
    if(!layout) return;
    newZoom = Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, newZoom));
    const field = document.getElementById('heartField');
    const rect = field.getBoundingClientRect();
    const cx = clientX - rect.left - rect.width/2;
    const cy = clientY - rect.top - rect.height/2;
    const worldX = targetOriginX + cx/targetZoom;
    const worldY = targetOriginY + cy/targetZoom;
    const newOriginX = worldX - cx/newZoom;
    const newOriginY = worldY - cy/newZoom;
    const clamped = clampOrigin(newOriginX, newOriginY, newZoom);
    targetZoom = newZoom;
    targetOriginX = clamped.x; targetOriginY = clamped.y;
    kickZoomLoop();
  }
  function applyPanDelta(dxScreen, dyScreen){
    if(!layout) return;
    const clamped = clampOrigin(targetOriginX - dxScreen/targetZoom, targetOriginY - dyScreen/targetZoom, targetZoom);
    targetOriginX = clamped.x; targetOriginY = clamped.y;
    kickZoomLoop();
  }
  function resetHeart(){
    targetZoom = ZOOM_MIN; targetOriginX = 0; targetOriginY = 0;
    kickZoomLoop();
  }

  function kickZoomLoop(){
    if(!zoomRafId) zoomRafId = requestAnimationFrame(zoomFrame);
  }
  function zoomFrame(){
    if(!layout){ zoomRafId = null; return; }
    // Molla leggermente sottosmorzata SOLO sullo zoom, per una sensazione più
    // elastica quando si apre/chiude il cuore. Converge comunque esattamente
    // a targetZoom (nessuna posizione diversa da quella già calcolata altrove).
    const STIFFNESS = 0.26, DAMPING = 0.72, panEase = 0.18;
    const force = (targetZoom - zoom) * STIFFNESS;
    zoomVel = (zoomVel + force) * DAMPING;
    zoom += zoomVel;
    originX += (targetOriginX - originX) * panEase;
    originY += (targetOriginY - originY) * panEase;

    const field = document.getElementById('heartField');
    const rect = field.getBoundingClientRect();
    const fw = rect.width, fh = rect.height;

    // La dimensione cresce più lentamente della distanza (SIZE_GROWTH < 1):
    // ecco perché aprendo lo zoom le foto si separano invece di restare
    // sovrapposte nella stessa proporzione.
    const displaySize = layout.aSize * (1 + (zoom - 1) * SIZE_GROWTH);

    photoMeta.forEach(p=>{
      // Unica formula, uguale per ogni foto, che dipende SOLO dalla sua
      // posizione base fissa e dalla telecamera attuale: nessun ricalcolo
      // rispetto alle altre foto.
      const screenX = fw/2 + (p.baseX - originX) * zoom;
      const screenY = fh/2 + (p.baseY - originY) * zoom;

      p.el.style.width = displaySize.toFixed(1) + 'px';
      p.el.style.transform = `translate3d(${screenX.toFixed(1)}px, ${screenY.toFixed(1)}px, 0) translate(-50%,-50%) rotate(${p.rot}deg)`;
    });

    field.classList.toggle('is-zoomed', zoom > ZOOM_MIN + 0.03);

    const settled = Math.abs(targetZoom-zoom) < 0.0008 && Math.abs(zoomVel) < 0.0008
      && Math.abs(targetOriginX-originX) < 0.4 && Math.abs(targetOriginY-originY) < 0.4;
    if(!settled){ zoomRafId = requestAnimationFrame(zoomFrame); } else { zoomRafId = null; zoomVel = 0; }
  }

  function initHeartZoom(){
    const field = document.getElementById('heartField');

    /* ---- desktop: rotella per aprire/chiudere, trascinamento per esplorare ---- */
    field.addEventListener('wheel', e=>{
      e.preventDefault();
      const factor = Math.exp(-e.deltaY * 0.0016);
      applyZoomAt(targetZoom * factor, e.clientX, e.clientY);
    }, {passive:false});

    field.addEventListener('mousedown', e=>{
      isPointerDown = true; dragMoved = false;
      lastPointer = {x:e.clientX, y:e.clientY};
      field.classList.add('is-panning');
    });
    field.addEventListener('mousemove', e=>{
      if(isPointerDown){
        const dx = e.clientX - lastPointer.x, dy = e.clientY - lastPointer.y;
        if(Math.abs(dx) > 2 || Math.abs(dy) > 2) dragMoved = true;
        lastPointer = {x:e.clientX, y:e.clientY};
        applyPanDelta(dx, dy);
      }
    });
    window.addEventListener('mouseup', ()=>{
      if(!isPointerDown) return;
      isPointerDown = false;
      field.classList.remove('is-panning');
      if(dragMoved){ wasDragging = true; setTimeout(()=>{ wasDragging = false; }, 60); }
    });

    /* ---- mobile: un dito trascina/esplora, due dita fanno pinch-to-zoom ---- */
    field.addEventListener('touchstart', e=>{
      if(e.touches.length === 1){
        const t = e.touches[0];
        lastPointer = {x:t.clientX, y:t.clientY};
        dragMoved = false;
      } else if(e.touches.length === 2){
        const [t1,t2] = e.touches;
        lastPinchDist = Math.hypot(t2.clientX-t1.clientX, t2.clientY-t1.clientY);
      }
    }, {passive:true});

    field.addEventListener('touchmove', e=>{
      if(e.touches.length === 1){
        e.preventDefault();
        const t = e.touches[0];
        const dx = t.clientX - lastPointer.x, dy = t.clientY - lastPointer.y;
        if(Math.abs(dx) > 2 || Math.abs(dy) > 2) dragMoved = true;
        lastPointer = {x:t.clientX, y:t.clientY};
        applyPanDelta(dx, dy);
      } else if(e.touches.length === 2){
        e.preventDefault();
        dragMoved = true;
        const [t1,t2] = e.touches;
        const dist = Math.hypot(t2.clientX-t1.clientX, t2.clientY-t1.clientY);
        const midX = (t1.clientX+t2.clientX)/2, midY = (t1.clientY+t2.clientY)/2;
        if(lastPinchDist != null){
          const ratio = dist / lastPinchDist;
          applyZoomAt(targetZoom * ratio, midX, midY);
        }
        lastPinchDist = dist;
      }
    }, {passive:false});

    field.addEventListener('touchend', e=>{
      if(e.touches.length < 2) lastPinchDist = null;
      if(e.touches.length === 0 && dragMoved){
        wasDragging = true; setTimeout(()=>{ wasDragging = false; }, 60);
      }
    });

    /* ---- tornare al cuore chiuso ---- */
    field.addEventListener('dblclick', resetHeart);
    let lastTap = 0;
    field.addEventListener('touchend', e=>{
      const now = Date.now();
      if(now - lastTap < 300 && e.touches.length === 0) resetHeart();
      lastTap = now;
    });
  }
  initHeartZoom();

  /* ---------- sincronizzazione live ---------- */
  SharedSite.onChange((kind)=>{
    // Agenda: aggiorna la vista senza ricaricare la pagina.
    if(typeof renderCalendar === 'function') renderCalendar();
    if(typeof agendaMapInstance !== 'undefined' && agendaMapInstance && typeof renderAgendaMapMarkers === 'function') renderAgendaMapMarkers();

    // Foto: se arrivano da un altro dispositivo, ricostruisci il cuore.
    if(typeof HEART_PHOTOS !== 'undefined'){
      const shared = SharedSite.getPhotos();
      const merged = HEART_PHOTOS_BASE.concat(shared);
      const changed = merged.length !== HEART_PHOTOS.length || merged.some((x,i)=>x!==HEART_PHOTOS[i]);
      if(changed){ HEART_PHOTOS = merged; if(typeof renderHeart === 'function') renderHeart(); }
    }
  });

</script>

