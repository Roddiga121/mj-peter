<script src="https://www.gstatic.com/firebasejs/10.12.2/firebase-database-compat.js"></script>
<script>
/* ================================================================
   SINCRONIZZAZIONE CONDIVISA
   Crea un progetto Firebase Realtime Database e incolla qui la
   configurazione della tua app web. Le modifiche a calendario e foto
   vengono poi sincronizzate per tutti i visitatori del sito.
   ================================================================ */
window.SHARED_FIREBASE_CONFIG = {
  apiKey: "AIzaSyADubB29DmZnVMMjQ3XPYEkokiaWVN-iU",
  authDomain: "scrapbook-gabriele.firebaseapp.com",
  databaseURL: "https://scrapbook-gabriele-default-rtdb.europe-west1.firebasedatabase.app",
  projectId: "scrapbook-gabriele",
  storageBucket: "scrapbook-gabriele.firebasestorage.app",
  messagingSenderId: "108374954836",
  appId: "1:108374954836:web:5150b928bce1cc3dadec55"
};

window.SharedSite = (() => {
  const cfg = window.SHARED_FIREBASE_CONFIG;
  const configured = cfg.apiKey && !cfg.apiKey.startsWith('INSERISCI_') &&
                     cfg.databaseURL && !cfg.databaseURL.includes('INSERISCI_PROJECT_ID');
  let db = null;
  let ready = false;
  const state = {
    customEvents: [],
    overrides: {},
    deletions: [],
    photos: []
  };
  const listeners = [];

  function notify(kind){ listeners.forEach(fn => { try{ fn(kind, state); }catch(e){ console.error(e); } }); }
  function onChange(fn){ listeners.push(fn); }
  function setLocal(key, value){ try{ localStorage.setItem(key, JSON.stringify(value)); }catch(e){} }
  function getLocal(key, fallback){ try{ return JSON.parse(localStorage.getItem(key) || JSON.stringify(fallback)); }catch(e){ return fallback; } }
  function idForEvent(ev){ return ev.id || ('custom-' + Date.now() + '-' + Math.random().toString(36).slice(2,8)); }
  function photoId(data){
    let h=2166136261;
    for(let i=0;i<data.length;i++){ h ^= data.charCodeAt(i); h = Math.imul(h,16777619); }
    return 'photo-' + (h>>>0).toString(36);
  }
  function normalizeLocal(){
    state.customEvents = getLocal('agenda-custom-events', []).map(ev => ({...ev, id:idForEvent(ev)}));
    state.overrides = getLocal('agenda-event-overrides', {});
    state.deletions = getLocal('agenda-event-deletions', []);
    state.photos = getLocal('heart-custom-photos', []).map(data => ({id:photoId(data), data}));
    setLocal('agenda-custom-events', state.customEvents);
  }
  function mergeAndPersist(remote){
    const remoteEvents = Array.isArray(remote?.customEvents) ? remote.customEvents : [];
    const byId = new Map(remoteEvents.map(e=>[e.id,e]));
    state.customEvents.forEach(e=>byId.set(e.id,e));
    state.customEvents = [...byId.values()];

    state.overrides = {...(remote?.overrides||{}), ...state.overrides};
    state.deletions = [...new Set([...(remote?.deletions||[]), ...state.deletions])];

    const remotePhotos = Array.isArray(remote?.photos) ? remote.photos : [];
    const pmap = new Map(remotePhotos.map(p=>[p.id || photoId(p.data), p]));
    state.photos.forEach(p=>pmap.set(p.id,p));
    state.photos = [...pmap.values()];

    setLocal('agenda-custom-events', state.customEvents);
    setLocal('agenda-event-overrides', state.overrides);
    setLocal('agenda-event-deletions', state.deletions);
    setLocal('heart-custom-photos', state.photos.map(p=>p.data));
  }
  async function push(){
    if(!db) return;
    try{
      // Photos are stored as compressed data URLs. This is appropriate for a small private scrapbook;
      // for hundreds of photos, Firebase Storage should be used instead.
      await db.ref('sharedSite').set({
        customEvents: state.customEvents,
        overrides: state.overrides,
        deletions: state.deletions,
        photos: state.photos
      });
    }catch(e){ console.error('Sincronizzazione Firebase fallita:',e); }
  }
  function init(){
    normalizeLocal();
    if(!configured){
      console.warn('Firebase non configurato: uso il salvataggio locale.');
      return;
    }
    try{
      if(!firebase.apps.length) firebase.initializeApp(cfg);
      db = firebase.database();
      db.ref('sharedSite').once('value').then(snap=>{
        const remote = snap.val() || {};
        mergeAndPersist(remote);
        ready = true;
        push();
        notify('initial');
      }).catch(e=>console.error('Impossibile leggere Firebase:',e));
      db.ref('sharedSite').on('value', snap=>{
        if(!ready) return;
        const remote = snap.val() || {};
        // Il listener riceve anche le nostre scritture: in quel caso aggiorniamo
        // comunque lo stato locale, mantenendo gli stessi ID per evitare duplicati.
        state.customEvents = Array.isArray(remote.customEvents) ? remote.customEvents : [];
        state.overrides = remote.overrides || {};
        state.deletions = Array.isArray(remote.deletions) ? remote.deletions : [];
        state.photos = Array.isArray(remote.photos) ? remote.photos : [];
        setLocal('agenda-custom-events', state.customEvents);
        setLocal('agenda-event-overrides', state.overrides);
        setLocal('agenda-event-deletions', state.deletions);
        setLocal('heart-custom-photos', state.photos.map(p=>p.data));
        notify('remote');
      });
    }catch(e){ console.error('Firebase non disponibile:',e); }
  }
  function getCustomEvents(){ return state.customEvents; }
  function getOverrides(){ return state.overrides; }
  function getDeletions(){ return state.deletions; }
  function getPhotos(){ return state.photos.map(p=>p.data); }
  function saveCustomEvents(v){ state.customEvents=v; setLocal('agenda-custom-events',v); push(); notify('local'); }
  function saveOverrides(v){ state.overrides=v; setLocal('agenda-event-overrides',v); push(); notify('local'); }
  function saveDeletions(v){ state.deletions=v; setLocal('agenda-event-deletions',v); push(); notify('local'); }
  function savePhotos(arr){
    state.photos=arr.map(data=>({id:photoId(data),data}));
    setLocal('heart-custom-photos',arr);
    push(); notify('local');
  }
  init();
  return {onChange,getCustomEvents,getOverrides,getDeletions,getPhotos,saveCustomEvents,saveOverrides,saveDeletions,savePhotos,isConfigured:()=>configured};
})();
</script>
<script>
  /* ---------- lock screen ---------- */
  const PASSWORD = "2807"; // cambia qui la password che preferisci
  const pinInput = document.getElementById('lock-input');
  const pinDots = document.getElementById('pinDots');
  const lockCard = document.querySelector('.lock-card');
  const lockIcon = document.getElementById('lockIcon');
  function renderPinDots(){
    const len = Math.max(PASSWORD.length, 4);
    pinDots.innerHTML = '';
    for(let i=0;i<len;i++){
      const d = document.createElement('span');
      d.className = 'pin-dot';
      pinDots.appendChild(d);
    }
  }
  renderPinDots();
  pinInput.addEventListener('input', ()=>{
    const dots = pinDots.children;
    const v = pinInput.value;
    for(let i=0;i<dots.length;i++) dots[i].classList.toggle('filled', i < v.length);
    document.getElementById('lock-error').textContent = '';
  });
  function tryUnlock(){
    const val = pinInput.value.trim();
    if(val === PASSWORD){
      lockIcon.classList.add('success');
      document.getElementById('lock-error').textContent = '';
      setTimeout(()=>{
        document.getElementById('lock').classList.add('unlocked');
        const fw = document.getElementById('frameWrap');
        const hc = document.getElementById('homeCaption');
        if(fw) fw.classList.add('in');
        if(hc) hc.classList.add('in');
      }, 420);
    } else {
      document.getElementById('lock-error').textContent = "Non è quella giusta, riprova ✷";
      lockCard.classList.remove('shake'); void lockCard.offsetWidth; lockCard.classList.add('shake');
    }
  }
  pinInput.addEventListener('keydown', e=>{ if(e.key==='Enter') tryUnlock(); });
  requestAnimationFrame(()=>{ requestAnimationFrame(()=> lockCard.classList.add('in')); });

  /* ---------- navigation ---------- */
  function openPage(name){
    flash();
    document.getElementById('home').classList.add('hidden');
    document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
    const target = document.getElementById('page-'+name);
    target.classList.add('active');
    if(name === 'collage'){ computeLayout(); kickZoomLoop(); }
    // rientro elegante degli elementi principali della pagina, ogni volta che si apre
    const reveals = target.querySelectorAll('.reveal');
    reveals.forEach(el=>el.classList.remove('in-view'));
    void target.offsetWidth;
    requestAnimationFrame(()=>{
      requestAnimationFrame(()=> reveals.forEach(el=>el.classList.add('in-view')));
    });
  }
  function closePage(){
    flash();
    document.querySelectorAll('.page').forEach(p=>p.classList.remove('active'));
    document.getElementById('home').classList.remove('hidden');
  }
  function flash(){
    const g = document.getElementById('grain');
    g.classList.add('flash');
    setTimeout(()=>g.classList.remove('flash'), 140);
  }
  // tap-hold feedback for mobile (mimics hover lift on touch)
  document.querySelectorAll('.hotspot').forEach(h=>{
    h.addEventListener('touchstart', ()=>h.classList.add('tapped'));
    h.addEventListener('touchend', ()=>setTimeout(()=>h.classList.remove('tapped'),350));
  });

  /* ---------- copertina: leggero parallasse delle decorazioni ---------- */
  (function(){
    const tilt = document.getElementById('frameTilt');
    const wrap = document.getElementById('frameWrap');
    if(!tilt || !wrap) return;
    if(window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let targetX = 0, targetY = 0, curX = 0, curY = 0, raf = null;
    function loop(){
      curX += (targetX - curX) * 0.07;
      curY += (targetY - curY) * 0.07;
      tilt.style.transform = `rotateX(${curY.toFixed(2)}deg) rotateY(${curX.toFixed(2)}deg)`;
      if(Math.abs(targetX-curX) > 0.01 || Math.abs(targetY-curY) > 0.01){ raf = requestAnimationFrame(loop); }
      else{ raf = null; }
    }
    function kick(){ if(!raf) raf = requestAnimationFrame(loop); }
    window.addEventListener('mousemove', e=>{
      const r = wrap.getBoundingClientRect();
      const px = (e.clientX - r.left) / r.width;
      const py = (e.clientY - r.top) / r.height;
      if(px < -0.2 || px > 1.2 || py < -0.2 || py > 1.2) return;
      targetY = (px - 0.5) * -3.5;
      targetX = (py - 0.5) * 3.5;
      kick();
    });
    document.addEventListener('mouseleave', ()=>{ targetX = 0; targetY = 0; kick(); });
    if(window.DeviceOrientationEvent){
      window.addEventListener('deviceorientation', e=>{
        if(e.beta==null || e.gamma==null) return;
        targetX = Math.max(-3.5, Math.min(3.5, e.gamma * 0.12));
        targetY = Math.max(-3.5, Math.min(3.5, (e.beta-45) * 0.08));
        kick();
      });
    }
  })();

  /* ---------- music: player unico con selettore vintage ---------- */
  const TRACKS = {
    cassette: { uri:'spotify:track:60r5kXIqq9d89Y6SsNQC6o', title:'!ly', sub:'— Thasup feat. Coez', ded:'quella che ti ho dedicato io' },
    vinyl: { uri:"spotify:track:5EPsArc2UJzxBYTowEMfAG", title:"Niente Canzoni d'Amore", sub:'— Marracash', ded:'quella che mi hai dedicato tu' }
  };
  let musicMode = 'cassette';
  const controllers = {};

  function updateModeUI(){
    document.getElementById('modeKnob').dataset.mode = musicMode;
    document.querySelectorAll('.mode-label-item').forEach(el=>{
      el.classList.toggle('active', el.dataset.mode === musicMode);
    });
    document.getElementById('cassetteDeck').style.display = musicMode === 'cassette' ? 'flex' : 'none';
    document.getElementById('turntableDeck').style.display = musicMode === 'vinyl' ? 'flex' : 'none';
    document.getElementById('spotify-embed-cassette').style.display = musicMode === 'cassette' ? 'block' : 'none';
    document.getElementById('spotify-embed-vinyl').style.display = musicMode === 'vinyl' ? 'block' : 'none';
    const t = TRACKS[musicMode];
    document.getElementById('trackTitle').innerHTML = `${t.title} <span style="font-weight:400;">${t.sub}</span>`;
    document.getElementById('trackDed').textContent = t.ded;
    document.getElementById('playBtn').textContent = '▶ riproduci';
    document.getElementById('cassetteDeck').classList.remove('playing');
    document.getElementById('turntableDeck').classList.remove('playing');
    document.getElementById('eqBars').classList.remove('playing');
  }

  document.getElementById('modeKnob').addEventListener('click', ()=>{
    const cur = controllers[musicMode];
    if(cur) cur.pause();
    musicMode = musicMode === 'cassette' ? 'vinyl' : 'cassette';
    updateModeUI();
  });

  window.onSpotifyIframeApiReady = (IFrameAPI) => {
    Object.keys(TRACKS).forEach(mode=>{
      const mountId = mode === 'cassette' ? 'spotify-embed-cassette' : 'spotify-embed-vinyl';
      const el = document.getElementById(mountId);
      IFrameAPI.createController(el, { uri: TRACKS[mode].uri, width: '100%', height: '80' }, (EmbedController) => {
        controllers[mode] = EmbedController;
        EmbedController.addListener('playback_update', e => {
          if(mode !== musicMode) return;
          const isPlaying = !e.data.isPaused;
          document.getElementById('cassetteDeck').classList.toggle('playing', isPlaying && musicMode==='cassette');
          document.getElementById('turntableDeck').classList.toggle('playing', isPlaying && musicMode==='vinyl');
          document.getElementById('eqBars').classList.toggle('playing', isPlaying);
          document.getElementById('playBtn').textContent = isPlaying ? '⏸ in riproduzione...' : '▶ riproduci';
        });
      });
    });
  };

  document.getElementById('playBtn').addEventListener('click', ()=>{
    const c = controllers[musicMode];
    if(c) c.togglePlay();
  });

  updateModeUI();

  /* ---------- da quanto tempo insieme ---------- */
  const START_DATE = new Date(2025, 6, 28, 0, 0, 0); // 28 luglio 2025
  function updateTogether(){
    const now = new Date();
    let y = now.getFullYear() - START_DATE.getFullYear();
    let m = now.getMonth() - START_DATE.getMonth();
    let d = now.getDate() - START_DATE.getDate();
    if(d < 0){
      m--;
      const prevMonth = new Date(now.getFullYear(), now.getMonth(), 0);
      d += prevMonth.getDate();
    }
    if(m < 0){ y--; m += 12; }
    const totalDays = Math.floor((now - START_DATE) / 86400000);
    const monthiversari = y*12 + m;

    const parts = [];
    if(y>0) parts.push(`${y} ${y===1?'anno':'anni'}`);
    parts.push(`${m} ${m===1?'mese':'mesi'}`);
    parts.push(`${d} ${d===1?'giorno':'giorni'}`);
    document.getElementById('together-main').textContent = parts.join(', ') + ' insieme';
    document.getElementById('together-sub').textContent =
      `${totalDays.toLocaleString('it-IT')} giorni in totale · ${monthiversari}° mesiversario festeggiato`;
  }
  updateTogether();
  setInterval(updateTogether, 1000);

  /* ---------- countdown ---------- */
  function nextMonthiversario(now){
    let d = new Date(now.getFullYear(), now.getMonth(), 28, 0,0,0);
    if(d <= now) d = new Date(now.getFullYear(), now.getMonth()+1, 28, 0,0,0);
    return d;
  }
  function nextAnniversario(now){
    let d = new Date(now.getFullYear(), 6, 28, 0,0,0); // luglio = mese 6
    if(d <= now) d = new Date(now.getFullYear()+1, 6, 28, 0,0,0);
    return d;
  }
  function fmtWeekdayDate(d){
    const s = d.toLocaleDateString('it-IT', {weekday:'long', day:'numeric', month:'long', year:'numeric'});
    return s.charAt(0).toUpperCase()+s.slice(1);
  }
  function renderUnits(container, diffMs){
    const s = Math.max(0, Math.floor(diffMs/1000));
    const days = Math.floor(s/86400);
    const hours = Math.floor((s%86400)/3600);
    const mins = Math.floor((s%3600)/60);
    const secs = s%60;
    container.innerHTML = [
      [days,'giorni'], [hours,'ore'], [mins,'min'], [secs,'sec']
    ].map(([n,l])=>`<div class="cd-unit"><div class="cd-num">${n}</div><div class="cd-label">${l}</div></div>`).join('');
  }
  function updateCountdowns(){
    const now = new Date();

    const mv = nextMonthiversario(now);
    document.getElementById('mv-date').textContent = fmtWeekdayDate(mv);
    renderUnits(document.getElementById('mv-grid'), mv - now);
    const mvStart = new Date(mv); mvStart.setMonth(mvStart.getMonth()-1);
    const mvPct = Math.min(100, Math.max(0, ((now-mvStart)/(mv-mvStart))*100));
    document.getElementById('mv-progress').style.width = mvPct+'%';
    document.getElementById('mv-heart').style.left = mvPct+'%';

    const ann = nextAnniversario(now);
    document.getElementById('ann-date').textContent = fmtWeekdayDate(ann);
    renderUnits(document.getElementById('ann-grid'), ann - now);
    const annStart = new Date(ann); annStart.setFullYear(annStart.getFullYear()-1);
    const annPct = Math.min(100, Math.max(0, ((now-annStart)/(ann-annStart))*100));
    document.getElementById('ann-progress').style.width = annPct+'%';
    document.getElementById('ann-heart').style.left = annPct+'%';
  }
  updateCountdowns();
