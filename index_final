  function baseEventsResolved(){
    // I ricordi storici (timelineData) non vengono mai riscritti: le modifiche
    // e le eliminazioni vivono solo in localStorage, sovrapposte per id ("base-<indice>").
    const overrides = loadOverrides();
    const deleted = new Set(loadDeletions());
    return timelineData
      .map((ev, i) => ({ ...ev, id: 'base-' + i }))
      .filter(ev => !deleted.has(ev.id))
      .map(ev => overrides[ev.id] ? { ...ev, ...overrides[ev.id] } : ev);
  }
  function allEvents(){ return baseEventsResolved().concat(loadCustomEvents()); }
  function eventCoversDay(ev, dateStr){
    if(ev.endDate){ return dateStr >= ev.date && dateStr <= ev.endDate; }
    return dateStr === ev.date;
  }
  function findEventsForDay(dateStr){ return allEvents().filter(ev => eventCoversDay(ev, dateStr)); }

  const MONTH_NAMES = ['Gennaio','Febbraio','Marzo','Aprile','Maggio','Giugno','Luglio','Agosto','Settembre','Ottobre','Novembre','Dicembre'];
  let calYear, calMonth;

  function initCalendar(){
    const evs = allEvents();
    if(evs.length){
      const last = evs.reduce((a,b)=> (b.date > a.date ? b : a));
      const d = new Date(last.date + 'T00:00:00');
      calYear = d.getFullYear(); calMonth = d.getMonth();
    } else {
      const now = new Date(); calYear = now.getFullYear(); calMonth = now.getMonth();
    }
    renderCalendar();
  }
  function shiftMonth(dir){
    const grid = document.getElementById('calGrid');
    const label = document.getElementById('calMonthLabel');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if(reduceMotion){
      calMonth += dir;
      if(calMonth < 0){ calMonth = 11; calYear--; }
      if(calMonth > 11){ calMonth = 0; calYear++; }
      renderCalendar();
      return;
    }
    grid.style.setProperty('--cal-slide', (dir>0 ? '14px' : '-14px'));
    grid.classList.add('switching');
    label.classList.add('switching');
    setTimeout(()=>{
      calMonth += dir;
      if(calMonth < 0){ calMonth = 11; calYear--; }
      if(calMonth > 11){ calMonth = 0; calYear++; }
      renderCalendar();
      requestAnimationFrame(()=>{
        grid.classList.remove('switching');
        label.classList.remove('switching');
      });
    }, 140);
  }
  function renderCalendar(){
    document.getElementById('calMonthLabel').textContent = `${MONTH_NAMES[calMonth]} ${calYear}`;
    const grid = document.getElementById('calGrid');
    grid.innerHTML = '';
    const firstDay = new Date(calYear, calMonth, 1);
    let startWeekday = firstDay.getDay();
    startWeekday = (startWeekday + 6) % 7; // lunedì = 0
    const daysInMonth = new Date(calYear, calMonth+1, 0).getDate();

    for(let i=0; i<startWeekday; i++){
      const empty = document.createElement('div');
      empty.className = 'cal-day empty';
      grid.appendChild(empty);
    }
    for(let day=1; day<=daysInMonth; day++){
      const dateStr = `${calYear}-${String(calMonth+1).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
      const dayEvents = findEventsForDay(dateStr);
      const cell = document.createElement('div');
      cell.className = 'cal-day';
      cell.textContent = day;
      if(dayEvents.length){
        cell.classList.add('has-event');
        if(dayEvents.some(e=>e.highlight)) cell.classList.add('highlight');
        const dot = document.createElement('div');
        dot.className = 'dot';
        cell.appendChild(dot);
        cell.addEventListener('click', ()=> openEventModal(dayEvents));
      }
      grid.appendChild(cell);
    }
  }
