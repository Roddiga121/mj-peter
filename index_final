      p.classList.toggle('flipped', i < bookIndex);
    });
    document.getElementById('bookCount').textContent = pages.length ? `${Math.min(bookIndex+1,pages.length)} / ${pages.length}` : '';
  }
  function turnBook(dir){
    bookIndex = Math.min(pages.length, Math.max(0, bookIndex+dir));
