  function deleteEditingEvent(){
    if(!editingEventId) return;
    if(!confirm('Eliminare questo ricordo? Non si può annullare ✷')) return;
    if(editingEventId.startsWith('base-')){
      const deletions = loadDeletions();
      if(!deletions.includes(editingEventId)){ deletions.push(editingEventId); saveDeletions(deletions); }
      const overrides = loadOverrides();
      if(overrides[editingEventId]){ delete overrides[editingEventId]; saveOverrides(overrides); }
    } else {
      const custom = loadCustomEvents().filter(e => e.id !== editingEventId);
      SharedSite.saveCustomEvents(custom);
    }
    resetAddForm();
    closeAddModal();
    renderCalendar();
    if(agendaMapInstance) renderAgendaMapMarkers();
  }
