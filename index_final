  function renderAgendaMapMarkers(){
    if(!agendaMapInstance) return;
    agendaMapMarkers.forEach(m => agendaMapInstance.removeLayer(m));
    agendaMapMarkers = [];
    PLACES.forEach(place=>{
      const count = allEvents().filter(ev => eventPlaceIds(ev).includes(place.id)).length;
      const icon = L.divIcon({
        className: 'scrap-marker',
        html: `<div class="scrap-pin"><span class="scrap-emoji">${place.emoji}</span><span class="scrap-badge">${count}</span></div>`,
        iconSize: [40,40],
        iconAnchor: [20,38],
        popupAnchor: [0,-34]
      });
      const marker = L.marker([place.lat, place.lng], { icon }).addTo(agendaMapInstance);
      marker.bindPopup(buildPlacePopupHTML(place), { maxWidth: 260 });
      marker.on('click', ()=>{
        const el = marker.getElement();
        const pin = el ? el.querySelector('.scrap-pin') : null;
        if(pin){ pin.classList.remove('bounce'); void pin.offsetWidth; pin.classList.add('bounce'); }
      });
      agendaMapMarkers.push(marker);
    });
  }

